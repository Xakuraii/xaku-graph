# XakuGraph Environment Configuration Example
# Copy this file to .env for local adjustments

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "tauri://localhost"]

# Data & Storage Directories
DATA_DIR=../data
UPLOADS_DIR=../data/uploads
PROCESSED_DIR=../data/processed
CACHE_DIR=../data/cache

# Processing Limits
MAX_UPLOAD_SIZE_MB=100
MAX_PREVIEW_ROWS=1000

# Security (Local-first Token for API access protection)
API_SECRET_KEY=change-this-in-production-or-leave-for-local-dev
